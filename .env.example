# FDR-SMART Frontend environment variables (Vite)
# Copy to ".env" for local dev, or set these in Vercel Project Settings > Environment Variables.
# Only VITE_* variables are exposed to the browser; never put secrets here.

# Public URL of the FDR-SMART backend API.
# For local dev this can be left unset (the app falls back to "/api",
# which Vite proxies to http://127.0.0.1:8000 via vite.config.ts).
# For production on Vercel, set this to the backend's public base URL, e.g.:
#   VITE_API_URL=https://fdr-smart-backend.example.com/api
VITE_API_URL=
