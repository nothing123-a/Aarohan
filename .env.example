# Aarohan Frontend Environment Configuration (Vite)
# Copy to ".env" for local development, or set in Vercel Project Settings > Environment Variables.
# Only VITE_* variables are exposed to the browser; never put backend secrets here.

# Public base URL of the Aarohan backend API.
# - Local dev: Leave empty (Vite automatically proxies "/api" to http://127.0.0.1:8000 via vite.config.ts)
# - Production on Vercel: Set to your Render backend URL with "/api" suffix:
#   VITE_API_URL=https://aarohan-backend.onrender.com/api
VITE_API_URL=
