# FDR-SMART Backend Environment Configuration
# Copy this file to .env and adjust variables as needed

# Project
PROJECT_NAME="FDR-SMART Backend"
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fdr_smart

# JWT Authentication
# In production, use a strong random secret generated via `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage & Document Scrutiny
DOCUMENT_STORAGE_DIR=./storage/documents
MAX_FILE_SIZE_BYTES=15728640
