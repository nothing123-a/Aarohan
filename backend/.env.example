# Aarohan Backend Environment Configuration
# Copy this file to .env and adjust variables as needed

# Project
PROJECT_NAME="Aarohan Backend"
API_V1_PREFIX=/api/v1
FRONTEND_URL=https://aarohan.vercel.app

# Database Configuration
# - Local / Render Free: Leave unset or use SQLite default (sqlite:///./fdr_smart.db)
# - Production PostgreSQL (Render / Neon / Supabase):
#   DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite:///./fdr_smart.db

# JWT Authentication
# Render automatically generates this when using render.yaml
# Or generate one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage & Document Scrutiny
DOCUMENT_STORAGE_DIR=./storage/documents
MAX_FILE_SIZE_BYTES=15728640
