{
  "name": "garuda-netra-backend",
  "version": "0.0.1",
  "private": true,
  "description": "Backend API for Garuda Netra FDR Portal (SIH 2026 - SIH26265)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node -e \"require('./dist/config/database').runMigrations()\"",
    "db:seed": "node -e \"require('./dist/config/seed').runSeed()\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "dotenv": "^16.4.5",
    "multer": "^1.4.5-lts.1",
    "express-validator": "^7.1.0",
    "express-rate-limit": "^7.3.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/pg": "^8.11.6",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.3",
    "tsx": "^4.16.2"
  }
}
